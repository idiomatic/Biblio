  <name>Biblio</name>
  <developer id="com.rbrian">
    <name>Brian Harrison</name>
  </developer>
  <summary>Search your library’s catalog and manage holds</summary>
  <description>
    <p>Biblio is an app for libraries that use BiblioCommons. Search the catalog, see which
    branches have a copy, place and cancel holds, and check what you have out, for one or
    several library cards.</p>
  </description>
  <launchable type="desktop-id">com.rbrian.Biblio.desktop</launchable>
  <url type="homepage">https://github.com/idiomatic/Biblio</url>
