<?xml version="1.0" encoding="utf-8"?>
<!-- Saved passwords are encrypted with a device-bound Keystore key, and the borrowing history
     index stays on the device, so nothing is backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="borrowed/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="borrowed/" />
    </device-transfer>
</data-extraction-rules>
