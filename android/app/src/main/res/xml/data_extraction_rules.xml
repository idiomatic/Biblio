<?xml version="1.0" encoding="utf-8"?>
<!-- Saved passwords are encrypted with a device-bound Keystore key, so nothing is backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
